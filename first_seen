<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Time First Seen vs Application Start — Monthly</title>
<style>
  :root{ color-scheme: light dark; }
  .viz-root{
    color-scheme: light;
    --surface-1:      #fcfcfb;
    --page:           #f9f9f7;
    --text-primary:   #0b0b0b;
    --text-secondary: #52514e;
    --muted:          #898781;
    --grid:           #e1e0d9;
    --axis:           #c3c2b7;
    --border:         rgba(11,11,11,0.10);
    --series-1:       #2a78d6;  /* Time First Seen  */
    --series-2:       #eb6834;  /* Application Start */
    --panel:          #ffffff;
  }
  @media (prefers-color-scheme: dark){
    :root:where(:not([data-theme="light"])) .viz-root{
      color-scheme: dark;
      --surface-1:      #1a1a19;
      --page:           #0d0d0d;
      --text-primary:   #ffffff;
      --text-secondary: #c3c2b7;
      --muted:          #898781;
      --grid:           #2c2c2a;
      --axis:           #383835;
      --border:         rgba(255,255,255,0.10);
      --series-1:       #3987e5;
      --series-2:       #d95926;
      --panel:          #1f1f1e;
    }
  }
  :root[data-theme="dark"] .viz-root{
    color-scheme: dark;
    --surface-1:#1a1a19; --page:#0d0d0d; --text-primary:#fff; --text-secondary:#c3c2b7;
    --muted:#898781; --grid:#2c2c2a; --axis:#383835; --border:rgba(255,255,255,0.10);
    --series-1:#3987e5; --series-2:#d95926; --panel:#1f1f1e;
  }
  html,body{margin:0;padding:0;}
  .viz-root{
    background:var(--page); color:var(--text-primary);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    padding:28px 24px 36px; min-height:100vh; box-sizing:border-box;
  }
  .wrap{max-width:1080px;margin:0 auto;}
  .head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:6px;}
  h1{font-size:20px;line-height:1.25;margin:0 0 4px;font-weight:650;}
  .sub{color:var(--text-secondary);font-size:13.5px;margin:0;max-width:640px;}
  .controls{display:flex;gap:8px;align-items:center;}
  .btn{font:inherit;font-size:12.5px;color:var(--text-secondary);background:var(--panel);
    border:1px solid var(--border);border-radius:8px;padding:6px 11px;cursor:pointer;}
  .btn:hover{color:var(--text-primary);}
  .legend{display:flex;gap:18px;align-items:center;margin:14px 0 4px;flex-wrap:wrap;}
  .lg{display:flex;gap:7px;align-items:center;font-size:13px;color:var(--text-secondary);}
  .swatch{width:22px;height:3px;border-radius:2px;display:inline-block;}
  .card{background:var(--surface-1);border:1px solid var(--border);border-radius:12px;
    padding:10px 8px 6px;margin-top:8px;}
  svg{display:block;width:100%;height:auto;}
  .gl{stroke:var(--grid);stroke-width:1;}
  .axis{stroke:var(--axis);stroke-width:1;}
  .tick{fill:var(--muted);font-size:11px;font-variant-numeric:tabular-nums;}
  .axlabel{fill:var(--text-secondary);font-size:12px;}
  .s1{stroke:var(--series-1);}
  .s2{stroke:var(--series-2);}
  .dlabel1{fill:var(--series-1);font-size:12px;font-weight:600;}
  .dlabel2{fill:var(--series-2);font-size:12px;font-weight:600;}
  .hit{fill:transparent;}
  .cross{stroke:var(--axis);stroke-width:1;stroke-dasharray:3 3;opacity:0;}
  .mk{opacity:0;}
  .tip{position:absolute;pointer-events:none;opacity:0;transform:translate(-50%,-115%);
    background:var(--panel);border:1px solid var(--border);border-radius:9px;
    padding:8px 10px;font-size:12.5px;color:var(--text-primary);
    box-shadow:0 6px 20px rgba(0,0,0,.14);white-space:nowrap;z-index:5;transition:opacity .08s;}
  .tip .tm{color:var(--muted);font-size:11px;margin-bottom:4px;}
  .tip .row{display:flex;gap:8px;align-items:center;justify-content:space-between;}
  .tip .row b{font-variant-numeric:tabular-nums;}
  .dot{width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:6px;vertical-align:middle;}
  .note{color:var(--text-secondary);font-size:12.5px;line-height:1.5;margin:16px 0 0;max-width:820px;}
  .band{fill:var(--muted);opacity:.07;}
  table.tv{border-collapse:collapse;width:100%;margin-top:14px;font-size:12.5px;
    font-variant-numeric:tabular-nums;display:none;}
  table.tv th,table.tv td{border-bottom:1px solid var(--border);padding:5px 8px;text-align:right;}
  table.tv th:first-child,table.tv td:first-child{text-align:left;font-variant-numeric:normal;}
  table.tv thead th{color:var(--text-secondary);font-weight:600;}
  .viz-root.showtable table.tv{display:table;}
</style>
</head>
<body>
<div class="viz-root" id="root">
 <div class="wrap">
  <div class="head">
    <div>
      <h1>Online applications: Time First Seen vs Application Start</h1>
      <p class="sub">Monthly contact counts for the same population (online programs, U.S., application started), viewed on two clocks. Sep 2022 – Jul 2026.</p>
    </div>
    <div class="controls">
      <button class="btn" id="themeBtn" type="button">Dark</button>
      <button class="btn" id="tableBtn" type="button">Table</button>
    </div>
  </div>

  <div class="legend">
    <span class="lg"><span class="swatch" style="background:var(--series-1)"></span>Time First Seen</span>
    <span class="lg"><span class="swatch" style="background:var(--series-2)"></span>Application Start</span>
    <span class="lg" style="color:var(--muted)"><span style="display:inline-block;width:12px;height:12px;background:var(--muted);opacity:.18;border-radius:2px;margin-right:6px;vertical-align:middle;"></span>Right-censored (recent, incomplete)</span>
  </div>

  <div class="card" style="position:relative;">
    <svg id="chart" viewBox="0 0 1040 440" role="img" aria-label="Line chart comparing monthly Time First Seen and Application Start counts"></svg>
    <div class="tip" id="tip"></div>
  </div>

  <table class="tv" id="tv">
    <thead><tr><th>Month</th><th>Time First Seen</th><th>Application Start</th><th>Diff</th></tr></thead>
    <tbody></tbody>
  </table>

  <p class="note"><b>How to read it:</b> the two lines track each other closely through the history (Pearson r = 0.67; 0.74 excluding the last three months) — same January peak, same summer trough. They align best in the <i>same</i> month, not on a lag. The shaded tail is where they diverge: because the report requires an application to exist, recently first-seen visitors who haven't applied yet are excluded, so <b>Time First Seen undercounts the last month or two</b> (July 2026 = 5 vs 91 app-starts). For recent demand, Application Start is the more reliable clock.</p>
 </div>
</div>

<script>
const DATA = [
 ["Sep 2022",95,49],["Oct 2022",115,78],["Nov 2022",92,74],["Dec 2022",81,60],
 ["Jan 2023",169,151],["Feb 2023",128,121],["Mar 2023",175,123],["Apr 2023",91,78],
 ["May 2023",107,125],["Jun 2023",79,68],["Jul 2023",93,87],["Aug 2023",93,118],
 ["Sep 2023",64,56],["Oct 2023",75,79],["Nov 2023",77,82],["Dec 2023",77,70],
 ["Jan 2024",147,122],["Feb 2024",103,96],["Mar 2024",112,96],["Apr 2024",101,93],
 ["May 2024",94,88],["Jun 2024",81,78],["Jul 2024",88,86],["Aug 2024",76,86],
 ["Sep 2024",63,63],["Oct 2024",97,95],["Nov 2024",85,86],["Dec 2024",96,101],
 ["Jan 2025",116,138],["Feb 2025",100,105],["Mar 2025",141,140],["Apr 2025",122,108],
 ["May 2025",114,111],["Jun 2025",94,106],["Jul 2025",106,107],["Aug 2025",97,101],
 ["Sep 2025",113,83],["Oct 2025",92,108],["Nov 2025",95,105],["Dec 2025",72,99],
 ["Jan 2026",122,136],["Feb 2026",86,98],["Mar 2026",98,124],["Apr 2026",138,152],
 ["May 2026",140,173],["Jun 2026",79,106],["Jul 2026",5,91]
];
const CENSOR_FROM = DATA.length-1; // Jul 2026 partial

const W=1040,H=440, m={l:46,r:18,t:18,b:46};
const iw=W-m.l-m.r, ih=H-m.t-m.b;
const n=DATA.length;
const maxY=200;
const x=i=> m.l + (n===1?0:i*(iw/(n-1)));
const y=v=> m.t + ih - (v/maxY)*ih;

const svg=document.getElementById('chart');
const NS="http://www.w3.org/2000/svg";
function el(t,a){const e=document.createElementNS(NS,t);for(const k in a)e.setAttribute(k,a[k]);return e;}

// gridlines + y ticks
for(let v=0;v<=maxY;v+=50){
  svg.appendChild(el('line',{class:'gl',x1:m.l,y1:y(v),x2:W-m.r,y2:y(v)}));
  const tk=el('text',{class:'tick',x:m.l-8,y:y(v)+4,'text-anchor':'end'});tk.textContent=v;svg.appendChild(tk);
}
// censor band
const bx=x(CENSOR_FROM-0.5);
svg.appendChild(el('rect',{class:'band',x:bx,y:m.t,width:(W-m.r)-bx,height:ih}));

// x ticks every 3 months
DATA.forEach((d,i)=>{ if(i%3===0){
  const tk=el('text',{class:'tick',x:x(i),y:H-m.b+18,'text-anchor':'middle'});
  tk.textContent=d[0].replace(' ',' '); svg.appendChild(tk);
}});
// axes
svg.appendChild(el('line',{class:'axis',x1:m.l,y1:m.t+ih,x2:W-m.r,y2:m.t+ih}));
const yl=el('text',{class:'axlabel',x:14,y:m.t+ih/2,'text-anchor':'middle',transform:`rotate(-90 14 ${m.t+ih/2})`});
yl.textContent='Contacts'; svg.appendChild(yl);

function path(idx,cls){
  let d='';DATA.forEach((row,i)=>{d+=(i?'L':'M')+x(i)+' '+y(row[idx])+' ';});
  svg.appendChild(el('path',{d,fill:'none',class:cls,'stroke-width':2,'stroke-linjoin':'round','stroke-linecap':'round'}));
}
path(1,'s1'); path(2,'s2');

// end direct labels
function endLabel(idx,cls){
  const last=DATA[n-1]; const t=el('text',{class:cls,x:x(n-1)-6,y:y(last[idx])+(idx===1?14:-8),'text-anchor':'end'});
  t.textContent=last[idx]; svg.appendChild(t);
}
// label the earlier stable point for TFS (avoid the censored dip) + app end
{
  const t=el('text',{class:'dlabel1',x:x(n-2)+6,y:y(DATA[n-2][1])-10,'text-anchor':'start'});
  t.textContent='79'; svg.appendChild(t);
}
endLabel(2,'dlabel2');

// interaction: crosshair + markers + tooltip
const cross=el('line',{class:'cross',y1:m.t,y2:m.t+ih}); svg.appendChild(cross);
const mk1=el('circle',{class:'mk',r:4.5,fill:'var(--surface-1)',stroke:'var(--series-1)','stroke-width':2});
const mk2=el('circle',{class:'mk',r:4.5,fill:'var(--surface-1)',stroke:'var(--series-2)','stroke-width':2});
svg.appendChild(mk1);svg.appendChild(mk2);
const tip=document.getElementById('tip');
const card=svg.parentElement;

function show(i,clientX){
  const d=DATA[i];
  cross.setAttribute('x1',x(i));cross.setAttribute('x2',x(i));cross.style.opacity=1;
  mk1.setAttribute('cx',x(i));mk1.setAttribute('cy',y(d[1]));mk1.style.opacity=1;
  mk2.setAttribute('cx',x(i));mk2.setAttribute('cy',y(d[2]));mk2.style.opacity=1;
  const rect=svg.getBoundingClientRect(); const sx=rect.width/W;
  const px=rect.left - card.getBoundingClientRect().left + x(i)*sx;
  const py=rect.top - card.getBoundingClientRect().top + Math.min(y(d[1]),y(d[2]))*(rect.height/H);
  const cen = i>=CENSOR_FROM ? '<div class="tm" style="color:var(--series-1)">partial / censored month</div>' : '';
  tip.innerHTML=`<div class="tm">${d[0]}</div>`+cen+
    `<div class="row"><span><span class="dot" style="background:var(--series-1)"></span>Time First Seen</span><b>${d[1]}</b></div>`+
    `<div class="row"><span><span class="dot" style="background:var(--series-2)"></span>Application Start</span><b>${d[2]}</b></div>`;
  tip.style.left=px+'px'; tip.style.top=py+'px'; tip.style.opacity=1;
}
function hide(){cross.style.opacity=0;mk1.style.opacity=0;mk2.style.opacity=0;tip.style.opacity=0;}
const hit=el('rect',{class:'hit',x:m.l,y:m.t,width:iw,height:ih});
svg.appendChild(hit);
svg.addEventListener('mousemove',e=>{
  const rect=svg.getBoundingClientRect();
  const px=(e.clientX-rect.left)*(W/rect.width);
  let i=Math.round((px-m.l)/(iw/(n-1)));
  i=Math.max(0,Math.min(n-1,i));
  show(i,e.clientX);
});
svg.addEventListener('mouseleave',hide);

// table view
const tb=document.querySelector('#tv tbody');
DATA.forEach(d=>{const tr=document.createElement('tr');
  tr.innerHTML=`<td>${d[0]}</td><td>${d[1]}</td><td>${d[2]}</td><td>${d[2]-d[1]>0?'+':''}${d[2]-d[1]}</td>`;
  tb.appendChild(tr);});

const root=document.getElementById('root');
document.getElementById('tableBtn').onclick=()=>root.classList.toggle('showtable');
const tbtn=document.getElementById('themeBtn');
tbtn.onclick=()=>{
  const cur=document.documentElement.getAttribute('data-theme');
  const next=cur==='dark'?'light':'dark';
  document.documentElement.setAttribute('data-theme',next);
  tbtn.textContent=next==='dark'?'Light':'Dark';
};
</script>
</body>
</html>
